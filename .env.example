# Aureven Flow — Environment Configuration Example

# Server & Runtime
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS in production (e.g., https://aureven-flow.app)
ALLOWED_ORIGINS=

# Optional custom executable paths (defaults to system PATH or project bin/)
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Custom temporary directory for video/audio processing
# TEMP_DIR=

# Concurrency Throttling (Maximum simultaneous downloads)
MAX_CONCURRENT_DOWNLOADS=3

# Rate Limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
ANALYZE_RATE_LIMIT=30
DOWNLOAD_RATE_LIMIT=20

# Operation Timeouts in milliseconds
ANALYZE_TIMEOUT_MS=120000
DOWNLOAD_TIMEOUT_MS=1800000
PROCESS_TIMEOUT_MS=1800000

# Optional Cloud Integrations
GEMINI_API_KEY=
APP_URL=
